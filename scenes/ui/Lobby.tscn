[gd_scene load_steps=2 format=3 uid="uid://lobby001"]

[ext_resource type="Script" path="res://scenes/ui/Lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
